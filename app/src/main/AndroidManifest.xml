<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".VeilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veil">
<!--        android:networkSecurityConfig="@xml/network_security_config"-->

        <!--
            Main activity — NO intent-filter here.
            The active alias below handles launcher entry.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!--
            ══════════════════════════════════════════════
            APP ICON ALIASES
            Only ONE alias is enabled at a time.
            AppIconManager switches between them at runtime.

            Icon drawables needed in res/mipmap-*:
              ic_launcher         (default ◈ logo)
              ic_launcher_ghost   (ghost version)
              ic_launcher_shield  (shield version)
              ic_launcher_lock    (lock version)
              ic_launcher_minimal (minimal dot version)

            The alias name must match AppIcon.aliasName in AppIcon enum.
            ══════════════════════════════════════════════
        -->

        <!-- DEFAULT icon — enabled on fresh install -->
        <activity-alias
            android:name=".icon.Default"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- GHOST icon -->
        <activity-alias
            android:name=".icon.Ghost"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ghost"
            android:roundIcon="@mipmap/ic_launcher_ghost"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- SHIELD icon -->
        <activity-alias
            android:name=".icon.Shield"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_shield"
            android:roundIcon="@mipmap/ic_launcher_shield"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- LOCK icon -->
        <activity-alias
            android:name=".icon.Lock"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_lock"
            android:roundIcon="@mipmap/ic_launcher_lock"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- MINIMAL icon -->
        <activity-alias
            android:name=".icon.Minimal"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_minimal"
            android:roundIcon="@mipmap/ic_launcher_minimal"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
